+/* OpenTyrianVR is hosted by Godot rather than SDLActivity. Its game library
+ * is loaded by Java, while SDL2 arrives as a DT_NEEDED dependency, so the VM
+ * does not call SDL2's JNI_OnLoad. Allow the host library's JNI_OnLoad to
+ * provide the VM without registering the SDLActivity Java bindings. */
+JNIEXPORT void JNICALL SDL_AndroidSetJavaVMForForeignActivity(JavaVM *vm)
+{
+    mJavaVM = vm;
+    Android_JNI_CreateKey_once();
+    SDL_SetMainReady();
+}
